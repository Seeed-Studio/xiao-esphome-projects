# XIAO ESP32-C5 has 8 MB flash. PSRAM is not needed by this radio-only image.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OpenThread runs as a Radio Co-Processor; the host runs OTBR/the Thread stack.
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_RADIO=y
CONFIG_OPENTHREAD_RADIO_NATIVE=y
CONFIG_OPENTHREAD_RCP_USB_SERIAL_JTAG=y
CONFIG_OPENTHREAD_TASK_SIZE=3072
# CONFIG_OPENTHREAD_CONSOLE_ENABLE is not set
# CONFIG_OPENTHREAD_CLI is not set
# CONFIG_OPENTHREAD_DIAG is not set
# CONFIG_OPENTHREAD_COMMISSIONER is not set
# CONFIG_OPENTHREAD_JOINER is not set
# CONFIG_OPENTHREAD_BORDER_ROUTER is not set
# CONFIG_OPENTHREAD_SRP_CLIENT is not set
# CONFIG_OPENTHREAD_DNS_CLIENT is not set
# CONFIG_ESP_COEX_SW_COEXIST_ENABLE is not set
CONFIG_OPENTHREAD_TIMING_OPTIMIZATION=y
CONFIG_FREERTOS_HZ=1000

# ESP-IDF requires the secondary USB Serial/JTAG console capability for USB
# RCP. Keep all application/Thread/boot logging silent on the Spinel channel.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NONE=y
CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=y

# Same size optimizations used by the upstream ot_rcp example.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
CONFIG_COMPILER_SAVE_RESTORE_LIBCALLS=y
# CONFIG_ESP_ERR_TO_NAME_LOOKUP is not set
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y
